      "author": {
        "id": 1127992
      },
      "writtenOn": "2023-08-04T20:38:22Z",
      "side": 1,
      "message": "The timing issue Liejun mentioned is additional to the EATT connect issue and specific to their implementation, see other b/281937405 which is fixed by this CL.\n\n Thus I don\u0027t agree with revert but rather can adjust this change in follow up CL if there is a different approach that we align on",
      "parentUuid": "af297355_9fb46e82",
      "revId": "2c2659e2c800b2d120dec471b2de203223f6ace4",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
