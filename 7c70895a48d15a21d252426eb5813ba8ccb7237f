      "lineNbr": 412,
      "author": {
        "id": 1960535
      },
      "writtenOn": "2023-08-17T08:24:21Z",
      "side": 1,
      "message": "But that is not what actually happens. The L2CAP sockets here don\u0027t underlie the RFCOMM sockets. The upper stack can choose to connect/listen to L2CAP sockets or RFCOMM sockets, and we need to disconnect them both. However I want to also return the status properly.\n\nMaybe I can rewrite to reflect this better.",
      "parentUuid": "e352400c_5b188292",
      "range": {
        "startLine": 412,
        "startChar": 2,
        "endLine": 412,
        "endChar": 54
      },
      "revId": "7c70895a48d15a21d252426eb5813ba8ccb7237f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
