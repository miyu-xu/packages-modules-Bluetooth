    {
      "unresolved": true,
      "key": {
        "uuid": "e5749c5b_e1ced06c",
        "filename": "service/src/com/android/server/bluetooth/BluetoothManagerService.java",
        "patchSetId": 4
      },
      "lineNbr": 1478,
