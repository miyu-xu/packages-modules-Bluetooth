      "writtenOn": "2023-02-03T14:32:31Z",
      "side": 1,
      "message": "Do we need to keep this API?",
      "range": {
        "startLine": 556,
        "startChar": 3,
        "endLine": 557,
        "endChar": 45
      },
      "revId": "2b5e25f6bb9f22212233b7144c28376ed848b6ab",
