    },
    {
      "unresolved": false,
      "key": {
        "uuid": "8b5f582f_ece6f05b",
        "filename": "framework/java/android/bluetooth/BluetoothLeBroadcast.java",
        "patchSetId": 14
      },
      "lineNbr": 557,
      "author": {
        "id": 1981586
      },
      "writtenOn": "2023-02-03T19:28:50Z",
      "side": 1,
      "message": "yes, we can make it backward compatible since the client app is not ready for the new api yet. in the future, we can consider to deprecate this",
      "parentUuid": "8f009b2b_d1cde089",
      "range": {
        "startLine": 556,
        "startChar": 3,
        "endLine": 557,
        "endChar": 45
      },
      "revId": "2b5e25f6bb9f22212233b7144c28376ed848b6ab",
