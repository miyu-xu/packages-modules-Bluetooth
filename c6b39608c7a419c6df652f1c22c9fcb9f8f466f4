      "lineNbr": 40,
      "author": {
        "id": 1884477
      },
      "writtenOn": "2024-10-07T20:45:48Z",
      "side": 1,
      "message": "You can maybe probe the data storage to check the CCC configuration for the CS characteristic when the connection is established, else wait for CCC to be written.",
