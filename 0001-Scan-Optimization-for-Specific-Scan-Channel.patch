+  void SetScanFilterPolicy(LeScanningFilterPolicy filter_policy) override;
+
+  /* Scan filter */
+  void ScanFilterEnable(bool enable) override;
+
+  void ScanFilterParameterSetup(ApcfAction action, uint8_t filter_index,
