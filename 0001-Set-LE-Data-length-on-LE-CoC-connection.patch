     // TODO(jpawlowski: for 16khz only 87 is required, optimize
-    if (get_btm_client_interface().ble.BTM_SetBleDataLength(address, 167) !=
+    if (get_btm_client_interface().ble.BTM_SetBleDataLength(address, 167, true) !=
