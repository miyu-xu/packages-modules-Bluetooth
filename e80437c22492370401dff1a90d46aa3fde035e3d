      "side": 1,
      "message": "If link up failed, shouldn\u0027t this be sending BT_ACL_STATE_DISCONNECTED?",
      "revId": "e80437c22492370401dff1a90d46aa3fde035e3d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
