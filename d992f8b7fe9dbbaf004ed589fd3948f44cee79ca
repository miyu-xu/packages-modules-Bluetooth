      "writtenOn": "2024-11-18T18:37:25Z",
      "side": 1,
      "message": "One of the reasons behind this feature is to be transparent with apps about link security. `UNKNOWN` does not convey anything about the link security.\n\nOnly E0 and AES encryption algorightms are supported in the Bluetooth specification.\nAdding a new algorithm would be a major change in the Bluetooth specification and would warrant a new feature work in Android Bluetooth wherein the new encryption algorithms must be added.",
      "parentUuid": "803ee790_1ac7edfe",
      "range": {
        "startLine": 523,
        "startChar": 4,
        "endLine": 533,
        "endChar": 57
      },
      "revId": "d992f8b7fe9dbbaf004ed589fd3948f44cee79ca",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
