      "writtenOn": "2023-10-02T23:45:22Z",
      "side": 1,
      "message": "The modifications to support encrypted advertising do not belong in the scanning reassembler. The only purpose of the reassembler is to collect the chunks of split extended advertising reports.\n\nDecryption should be performed in the caller of the reassembler, on the fully assembled report.",
      "revId": "c02b8f936ca78139a8326402982887bfbd21b03d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
