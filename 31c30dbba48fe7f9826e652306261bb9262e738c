      "writtenOn": "2022-03-07T22:59:34Z",
      "side": 1,
      "message": "Hi Mandip. \n\nThe problem here is that retrans_nb and max_transport_latency are tied together, and should not be compared/selected separately.\nSo if the logic was to either keep both, or drop parameters, it would work ok with the test devices.",
      "parentUuid": "bd3d4b2e_b8470d29",
      "range": {
        "startLine": 1166,
        "startChar": 48,
        "endLine": 1166,
        "endChar": 49
