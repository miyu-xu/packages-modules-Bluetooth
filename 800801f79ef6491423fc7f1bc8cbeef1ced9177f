    {
      "unresolved": false,
      "key": {
        "uuid": "7809da3d_7071eb4b",
        "filename": "android/app/src/com/android/bluetooth/avrcpcontroller/AvrcpControllerService.java",
        "patchSetId": 1
      },
      "lineNbr": 572,
      "author": {
        "id": 1427525
      },
      "writtenOn": "2022-10-26T17:02:04Z",
      "side": 1,
      "message": "I\u0027m holding the active device lock while processing the message, so the active device can\u0027t change while we\u0027re sending the message. This would cause this previous device (right before the switch) to pause when focus is removed. It would have _another_ pause sent once the active device change actually goes through.\n\nThe new active device would be paused in the existing active device switch logic too, so that\u0027s not a worry.\n\nPerhaps we should clean up the focus variables when we\u0027re no longer active though?",
      "parentUuid": "9376d9b4_3104f55e",
      "range": {
        "startLine": 572,
        "startChar": 11,
        "endLine": 572,
        "endChar": 85
      },
      "revId": "800801f79ef6491423fc7f1bc8cbeef1ced9177f",
