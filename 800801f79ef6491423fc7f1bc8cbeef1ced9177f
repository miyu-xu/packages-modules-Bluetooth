      "writtenOn": "2022-10-25T21:44:42Z",
      "side": 1,
      "message": "Is it possible for the active device to change in `case AUDIO_FOCUS_CHANGE:` in `A2dpSinkStreamHandler` (i.e., before/between when `avrcpControllerService.onAudioFocusStateChanged(mAudioFocus)` is called)?",
      "range": {
        "startLine": 572,
        "startChar": 11,
        "endLine": 572,
        "endChar": 85
      },
      "revId": "800801f79ef6491423fc7f1bc8cbeef1ced9177f",
