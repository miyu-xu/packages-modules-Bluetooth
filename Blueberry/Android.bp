package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "Blueberry",
    srcs: [
        "src/**/*.kt",
    ],
    sdk_version: "current",
    certificate: "platform",

    static_libs: [
        "androidx.test.runner",
        "androidx.test.core",
        "grpc-java-netty-shaded",
        "blueberry-grpc-java",
        "blueberry-proto-java",
    ],

    dex_preopt: {
        enabled: false,
    },
    optimize: {
        enabled: false,
    },
}

java_library {
    name: "blueberry-grpc-java",
    srcs: [
        "proto/blueberry/host.proto",
    ],
    static_libs: [
        "blueberry-proto-java",
        "grpc-java-lite",
        "guava",
        "opencensus-java-api",
        "libprotobuf-java-lite",
        "javax_annotation-api_1.3.2",
    ],
    proto: {
        include_dirs: [
            "external/protobuf/src",
        ],
        plugin: "grpc-java-plugin",
        output_params: [
           "lite",
        ],
    },
}

java_library {
    name: "blueberry-proto-java",
    srcs: [
        "proto/blueberry/host.proto",
        ":libprotobuf-internal-protos",
    ],
    static_libs: [
        "libprotobuf-java-lite",
    ],
    proto: {
        type: "lite",
        include_dirs: ["external/protobuf/src"],
    },
}