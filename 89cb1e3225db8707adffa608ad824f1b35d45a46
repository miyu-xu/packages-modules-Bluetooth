      "writtenOn": "2023-03-16T15:58:05Z",
      "side": 1,
      "message": "I don\u0027t think this is a race we can win.  When we get the user-switch notification, the current user is already different.  If we have any calls in flight, the verification will fail.  We don\u0027t have a good way of updating all profiles at the same time.",
      "parentUuid": "f9843561_b703d6e5",
      "range": {
        "startLine": 9,
        "startChar": 32,
        "endLine": 9,
        "endChar": 49
      },
      "revId": "89cb1e3225db8707adffa608ad824f1b35d45a46",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
