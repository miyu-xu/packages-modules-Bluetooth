      "writtenOn": "2023-10-30T14:03:21Z",
      "side": 1,
      "message": "Should be a bug fix, but originally it was never called because `restart_available_adapters` only restarted the `ProcessState::On` adapters.",
      "parentUuid": "97a2e0d9_6d446d5b",
      "range": {
        "startLine": 1428,
        "startChar": 12,
        "endLine": 1432,
        "endChar": 13
