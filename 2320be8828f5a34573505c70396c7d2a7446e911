        "uuid": "29946be6_18960c90",
        "filename": "tools/rootcanal/config.proto",
        "patchSetId": 3
      },
      "lineNbr": 24,
      "author": {
        "id": 1884477
      },
      "writtenOn": "2023-04-24T22:07:54Z",
      "side": 1,
      "message": "I was thinking something more obviously wrong, like ff:ff:ff:ff:ff:ff.\nEven though rootcanal would allow using the value we should make it obvious that the random address was unset.",
      "parentUuid": "1e7e3a6f_eb4c4023",
      "range": {
        "startLine": 24,
        "startChar": 7,
        "endLine": 24,
        "endChar": 33
      },
      "revId": "2320be8828f5a34573505c70396c7d2a7446e911",
