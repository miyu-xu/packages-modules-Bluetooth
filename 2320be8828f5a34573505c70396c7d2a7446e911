    },
    {
      "unresolved": true,
      "key": {
        "uuid": "5fc62a9b_b2d58067",
        "filename": "tools/rootcanal/config.proto",
        "patchSetId": 3
      },
      "lineNbr": 24,
      "author": {
        "id": 1076123
      },
      "writtenOn": "2023-04-24T22:10:03Z",
      "side": 1,
      "message": "When it\u0027s a broken address, why let it have that quirk?\n\nbb:aa:dd:bb:aa:dd is my favorite :)",
      "parentUuid": "29946be6_18960c90",
      "range": {
        "startLine": 24,
        "startChar": 7,
        "endLine": 24,
        "endChar": 33
      },
      "revId": "2320be8828f5a34573505c70396c7d2a7446e911",
