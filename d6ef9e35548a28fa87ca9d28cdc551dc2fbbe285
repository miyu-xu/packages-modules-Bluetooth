      "writtenOn": "2022-08-08T18:47:01Z",
      "side": 1,
      "message": "Can the `IsEmpty()` check ever fail if we are connected?",
      "revId": "d6ef9e35548a28fa87ca9d28cdc551dc2fbbe285",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
