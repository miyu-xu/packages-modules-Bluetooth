    },
    {
      "unresolved": false,
      "key": {
        "uuid": "3ad63ba4_cc45cb87",
        "filename": "framework/java/android/bluetooth/BluetoothManager.java",
        "patchSetId": 1
      },
      "lineNbr": 55,
