      },
      "writtenOn": "2023-12-26T07:34:44Z",
      "side": 1,
      "message": "We have some constants already defined using sys properties like those in device.mk. If possible, we want to keep them together.",
      "parentUuid": "1516c131_660daacd",
      "revId": "3fd0da30ccd386b4428c3e4c74196bf6d8b320d7",
