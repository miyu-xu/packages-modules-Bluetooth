      "writtenOn": "2025-01-10T22:26:51Z",
      "side": 1,
      "message": "Isn\u0027t warning too high here?",
      "range": {
        "startLine": 571,
        "startChar": 16,
        "endLine": 571,
        "endChar": 17
      },
      "revId": "82b01636d0bd5154613d72f56ae2b93a3262f430",
