      "writtenOn": "2023-02-08T03:50:37Z",
      "side": 1,
      "message": "Hmm, I don\u0027t quite get why we need two constants. We just want to translate unix timestamp to btsnoop timestamp, which is the conversion from year 0 to year 1970.",
      "parentUuid": "1823ae23_c8fa7ef2",
      "range": {
        "startLine": 121,
        "startChar": 6,
        "endLine": 121,
        "endChar": 31
      },
      "revId": "d5bfb1dc19774633a8f4dca6c68de70f416574da",
