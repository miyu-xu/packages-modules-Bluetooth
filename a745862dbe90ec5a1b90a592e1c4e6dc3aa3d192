      },
      "writtenOn": "2024-01-03T07:46:40Z",
      "side": 1,
      "message": "IIUC notification_success is always True as long as it\u0027s awaited and the `else` block would never run.",
      "parentUuid": "e90baf79_6e6e6ed1",
      "range": {
        "startLine": 588,
