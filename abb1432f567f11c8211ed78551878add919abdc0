      "writtenOn": "2023-04-18T14:49:44Z",
      "side": 1,
      "message": "May we separate the enablement of this to a follow up CL? This will may break ChromeOS that hasn\u0027t enabled the SWB support.",
      "range": {
        "startLine": 2185,
        "startChar": 16,
        "endLine": 2185,
        "endChar": 96
      },
      "revId": "abb1432f567f11c8211ed78551878add919abdc0",
