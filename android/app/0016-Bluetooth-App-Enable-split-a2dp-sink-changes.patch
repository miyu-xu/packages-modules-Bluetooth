+            case START_SINK:
+                if (mAudioManager != null) {
+                    mAudioManager.setParameters("btsink_enable=true");
+                }
+                break;
+
+            case STOP_SINK:
+                if (mAudioManager != null) {
+                    mAudioManager.setParameters("btsink_enable=false");
+                }
+                break;
+
+            case SET_ACTIVE:
+                if (mAudioManager != null) {
+                  mAudioManager.handleBluetoothA2dpActiveDeviceChange(
