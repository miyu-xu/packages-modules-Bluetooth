+                                 true, -1);
+                }
+                break;
+
+            case REMOVE_ACTIVE:
+                if (mAudioManager != null) {
+                  mAudioManager.handleBluetoothA2dpActiveDeviceChange(
+                                (BluetoothDevice) message.obj,
+                                 BluetoothProfile.STATE_DISCONNECTED,
+                                 BluetoothProfile.A2DP_SINK,
+                                 true, -1);
+                }
+                break;
