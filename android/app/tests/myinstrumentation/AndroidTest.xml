<configuration description="Pandora java tests.">
    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <option name="test-file-name" value="PandoraInstrumentationTests.apk" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RunHostCommandTargetPreparer">
        <option name="work-dir" value="external/pandora/avatar" />
        <option name="host-setup-command" value="virtualenv venv" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.PythonVirtualenvPreparer">
        <option name="venv-dir" value="external/pandora/avatar/venv"/>
        <option name="dep-module" value="grpcio-tools"/>
        <option name="dep-module" value="external/pandora/avatar/bt-test-interfaces/python/"/>
        <option name="dep-module" value="external/pandora/avatar/third-party/bumble/"/>
        <option name="dep-module" value="external/pandora/avatar/"/>
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RunHostCommandTargetPreparer">
        <option name="host-setup-command" value="adb reverse tcp:7999 tcp:7999" />
        <option name="host-teardown-command" value="adb reverse --remove tcp:7999" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RunHostCommandTargetPreparer">
        <option name="work-dir" value="external/pandora/avatar" />
        <option name="host-setup-command"
              value="venv/bin/python ./bt-test-interfaces/python/_build/grpc.py" />
        <option name="host-background-command"
              value="venv/bin/python avatar/bumble_server/__init__.py" />
    </target_preparer>

    <option name="test-tag" value="PandoraInstrumentationTests" />
    <test class="com.android.tradefed.testtype.AndroidJUnitTest" >
        <option name="package" value="com.android.bluetooth.myinstrumentation" />
        <option name="hidden-api-checks" value="false"/>
    </test>

    <!-- Only run if the Bluetooth Mainline module is installed. -->
    <object type="module_controller"
            class="com.android.tradefed.testtype.suite.module.MainlineTestModuleController">
        <option name="enable" value="true" />
        <option name="mainline-module-package-name" value="com.android.btservices" />
    </object>
</configuration>

