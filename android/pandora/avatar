#!/usr/bin/env bash

root=$(dirname "${BASH_SOURCE[0]}")

function check {
  ec="$?"
  if [[ "${ec}" -eq 0 ]]; then echo -e " OK"
  else echo -e " KO\n$1"; return "${ec}"; fi
}

echo -n "-- Setup virtual environment:"; check "$(
  if [ ! -d "${root}/venv" ]; then
    2>&1 python3 -m venv "${root}/venv"
  fi
)" || return

source "${root}/venv/bin/activate"

echo -n "-- Install python remote dependencies:"; check "$(
  2>/dev/null python -c 'import cryptography' || 2>&1 pip install \
    'cryptography==35' \
    'grpcio==1.51.1' \
    'grpcio-tools==1.51.1' \
    'protobuf==4.22.0' \
    'black==22.10.0' \
    'pyright==1.1.296' \
    'mypy==1.0' \
    'isort==5.12.0' \
    'types-psutil>=5.9.5.6' \
    'types-setuptools>=65.7.0.3' \
    'types-protobuf>=4.21.0.3'
  2>/dev/null python -c 'import mobly' || 2>&1 pip install "${root}/../../../../../external/python/mobly"
)" || return

while read r; do
  export PYTHONPATH="${PYTHONPATH}:$(realpath "${root}/$r")"
done < "${root}/requirements.txt"

echo -n "-- Generate Pandora python code:"; check "$(
   2>&1 python "./${root}/../../../../../external/pandora/bt-test-interfaces/python/_build/grpc.py"
   2>&1 python "${root}/../../pandora/interfaces/python/_build/grpc.py"
)" || return

if [[ $# -gt 0 ]]; then
  argv=("${@:2}" "${root}/test/main.py" "${root}/test/"*_test.py)
  if [[ "$1" == "format" ]]; then
    echo "-- Format:"
    black -S -l 119 "${argv[@]}"
    isort --profile black -l 119 --ds --lbt 1 --ca "${argv[@]}"
  elif [[ "$1" == "lint" ]]; then
    echo "-- Lint:"
    mypy --pretty --show-column-numbers --strict --no-warn-unused-ignores --ignore-missing-imports "${argv[@]}" || return
    pyright -p "${root}" "${argv[@]}"
  elif [[ "$1" == "clean" ]]; then
    echo "-- Clean:"
    rm -rf "${root}/venv"
  else
    echo "-- Run Avatar:"
    python "${root}/test/main.py" "$@"
  fi
fi
