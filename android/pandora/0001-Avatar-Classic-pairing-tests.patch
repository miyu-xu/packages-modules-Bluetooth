From 97c7ea5dc258515084e4287463c1631a2386e45c Mon Sep 17 00:00:00 2001
From: Josh Wu <joshwu@google.com>
Date: Tue, 30 Aug 2022 19:07:32 +0800
Subject: [PATCH] Avatar: Classic pairing tests

Tag: #feature
Test: atest avatar
Bug: 239903183
Change-Id: I5cc1e785957d0faa01f3c189d28258895a7fa7bb
---
 android/pandora/test/Android.bp      |  2 +-
 android/pandora/test/AndroidTest.xml |  3 +-
 android/pandora/test/config.yml      |  2 +
 android/pandora/test/connect.py      | 81 +++++++++++++++++++++++++++-
 4 files changed, 85 insertions(+), 3 deletions(-)

diff --git a/android/pandora/test/Android.bp b/android/pandora/test/Android.bp
index b2a67c957e..ec2949bf65 100644
--- a/android/pandora/test/Android.bp
+++ b/android/pandora/test/Android.bp
@@ -21,10 +21,10 @@ python_test_host {
     main: "connect.py",
     srcs: [
         "connect.py",
+        ":mmi2grpc",
     ],
     libs: [
         "libavatar",
-        "pandora_experimental-python",
     ],
     required: ["PandoraServer"],
     test_suites: ["general-tests"],
diff --git a/android/pandora/test/AndroidTest.xml b/android/pandora/test/AndroidTest.xml
index e198daaf92..62a6a7a63e 100644
--- a/android/pandora/test/AndroidTest.xml
+++ b/android/pandora/test/AndroidTest.xml
@@ -26,11 +26,12 @@
         <option name="dep-module" value="ansicolors" />
         <option name="dep-module" value="websockets" />
         <option name="dep-module" value="bitstruct" />
+        <option name="dep-module" value="parameterized" />
     </target_preparer>
     <test class="com.android.tradefed.testtype.mobly.MoblyBinaryHostTest">
         <option name="mobly-par-file-name" value="avatar" />
         <option name="mobly-config-file-name" value="config.yml" />
-        <option name="mobly-test-timeout" value="1800000" />
+        <option name="mobly-test-timeout" value="120000" />
     </test>
 </configuration>
 
diff --git a/android/pandora/test/config.yml b/android/pandora/test/config.yml
index bd43582247..ee5074e190 100644
--- a/android/pandora/test/config.yml
+++ b/android/pandora/test/config.yml
@@ -10,3 +10,5 @@ TestBeds:
     - class: BumblePandoraDevice
       transport: 'tcp-client:127.0.0.1:7300'
       classic_enabled: true
+      classic_sc_enabled: true
+      classic_ssp_enabled: true
diff --git a/android/pandora/test/connect.py b/android/pandora/test/connect.py
index 84c7bf3d84..be9ba86806 100644
--- a/android/pandora/test/connect.py
+++ b/android/pandora/test/connect.py
@@ -28,6 +28,9 @@ import google.protobuf.descriptor_pool
 google.protobuf.descriptor_pool.Default().__init__()
 
 from pandora_experimental.host_grpc import Host
+from pandora_experimental.security_pb2 import PairingEvent, PairingEventAnswer
+
+import bumble
 
 
 class ExampleTest(base_test.BaseTestClass):
@@ -42,12 +45,88 @@ class ExampleTest(base_test.BaseTestClass):
         # TODO: wait for server
         time.sleep(3)
 
-    def test_classic_connect(self):
+    def setup_test(self):
+        self.dut.host.HardReset()
+        self.ref.host.HardReset()
+
+    def test_classic_connect_from_ref(self):
         dut_address = self.dut.address
         self.dut.log.info(f'Address: {dut_address}')
         response = self.ref.host.Connect(address=dut_address)
         assert response.WhichOneof("result") == "connection"
 
+    def test_classic_connect_from_dut(self):
+        ref_address = self.ref.address
+        self.ref.log.info(f'Address: {ref_address}')
+        response = self.dut.host.Connect(address=ref_address)
+        assert response.WhichOneof("result") == "connection"
+
+    def _setup_connection(self, io_cap):
+        dut_address = self.dut.address
+        self.dut.log.info(f'Address: {dut_address}')
+        self.ref.server.security_service.set_pairing_config(io_cap=io_cap, bonding=True, mitm=True, sc=True)
+        response = self.ref.host.Connect(address=dut_address)
+        assert response.WhichOneof("result") == "connection"
+        return response
+
+    def test_classic_pair_from_ref_no_io(self):
+        response = self._setup_connection(bumble.smp.SMP_NO_INPUT_NO_OUTPUT_IO_CAPABILITY)
+
+        dut_pairing_event_stream = self.dut.security.OnPairing()
+
+        self.ref.security.Pair(connection=response.connection)
+        dut_pairing_event = dut_pairing_event_stream.recv()
+        dut_pairing_event_stream.send(event=dut_pairing_event, confirm=True)
+
+        # TODO: Wait for bond state instead of sleep
+        time.sleep(3)
+
+    def test_classic_pair_from_ref_display_only(self):
+        response = self._setup_connection(bumble.smp.SMP_DISPLAY_ONLY_IO_CAPABILITY)
+
+        dut_pairing_event_stream = self.dut.security.OnPairing()
+
+        self.ref.security.Pair(connection=response.connection)
+        dut_pairing_event = dut_pairing_event_stream.recv()
+        dut_pairing_event_stream.send(event=dut_pairing_event, confirm=True)
+
+        # TODO: Wait for bond state instead of sleep
+        time.sleep(3)
+
+    def test_classic_pair_from_ref_display_yes_no(self):
+        response = self._setup_connection(bumble.smp.SMP_DISPLAY_YES_NO_IO_CAPABILITY)
+
+        dut_pairing_event_stream = self.dut.security.OnPairing()
+        ref_pairing_event_stream = self.ref.security.OnPairing()
+
+        self.ref.security.Pair(connection=response.connection)
+        dut_pairing_event = dut_pairing_event_stream.recv()
+        ref_pairing_event = ref_pairing_event_stream.recv()
+        assert dut_pairing_event.WhichOneof("method") == ref_pairing_event.WhichOneof("method")
+        dut_pairing_event_stream.send(event=dut_pairing_event, confirm=True)
+        ref_pairing_event_stream.send(event=ref_pairing_event, confirm=True)
+        ref_pairing_event_stream.close()
+
+        # TODO: Wait for bond state instead of sleep
+        time.sleep(3)
+
+    def test_classic_pair_from_ref_keyboard_only(self):
+        response = self._setup_connection(bumble.smp.SMP_DISPLAY_ONLY_IO_CAPABILITY)
+
+        dut_pairing_event_stream = self.dut.security.OnPairing()
+        ref_pairing_event_stream = self.ref.security.OnPairing()
+
+        self.ref.security.Pair(connection=response.connection)
+        dut_pairing_event = dut_pairing_event_stream.recv()
+        ref_pairing_event = ref_pairing_event_stream.recv()
+        assert dut_pairing_event.WhichOneof("method") == ref_pairing_event.WhichOneof("method")
+        dut_pairing_event_stream.send(event=dut_pairing_event, confirm=True)
+        ref_pairing_event_stream.send(event=ref_pairing_event, confirm=True)
+        ref_pairing_event_stream.close()
+
+        # TODO: Wait for bond state instead of sleep
+        time.sleep(3)
+
 
 if __name__ == '__main__':
     # MoblyBinaryHostTest pass test_runner arguments after a "--"
