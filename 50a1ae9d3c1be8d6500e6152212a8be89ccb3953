        "id": 1836438
      },
      "writtenOn": "2022-03-25T21:06:50Z",
      "side": 1,
      "message": "Rustup doesn\u0027t provide a way to pin a specific release. You get to pick between stable and nightly.\n\nChromeOS has its own process for updating the toolchain and regularly updates to the latest stable release (and so does Android).",
      "parentUuid": "6473cc9c_755e1419",
      "range": {
        "startLine": 11,
        "startChar": 4,
        "endLine": 11,
        "endChar": 30
      },
      "revId": "50a1ae9d3c1be8d6500e6152212a8be89ccb3953",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "a206bd77_c6b49cbd",
        "filename": "/COMMIT_MSG",
        "patchSetId": 1
