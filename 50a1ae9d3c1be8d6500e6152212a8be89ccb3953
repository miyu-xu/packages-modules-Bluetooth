      "side": 1,
      "message": "Why not pin this stable release ?\nIs chromeos always using the latest rust stable ?",
      "range": {
        "startLine": 11,
        "startChar": 4,
        "endLine": 11,
        "endChar": 30
      },
      "revId": "50a1ae9d3c1be8d6500e6152212a8be89ccb3953",
