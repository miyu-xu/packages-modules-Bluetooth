      "author": {
        "id": 1881539
      },
      "writtenOn": "2022-03-25T14:39:19Z",
      "side": 1,
      "message": "Even if the image tag is fixed, the package that are installed with apt are subject to updates, if we want to avoid that we can pin each package version.",
      "range": {
        "startLine": 11,
        "startChar": 50,
        "endLine": 12,
        "endChar": 24
      },
      "revId": "50a1ae9d3c1be8d6500e6152212a8be89ccb3953",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
