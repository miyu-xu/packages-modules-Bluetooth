      "writtenOn": "2024-11-13T10:04:20Z",
      "side": 1,
      "message": "I think it\u0027s possible here the controller replies with command status fail - In this case there won\u0027t be a disconnection event, so probably we would need to revert the state to \"connected\" to sync with the controller.",
      "parentUuid": "ca555106_7aca22b8",
      "range": {
        "startLine": 212,
        "startChar": 78,
        "endLine": 212,
        "endChar": 96
      },
      "revId": "d5f71fc73685b9cffd30fc39fb107642aff54e78",
