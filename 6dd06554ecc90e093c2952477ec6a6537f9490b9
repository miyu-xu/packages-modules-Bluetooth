        "id": 1882530
      },
      "writtenOn": "2023-12-11T16:17:58Z",
      "side": 1,
      "message": "I was not able to add the GATT services in Bumble. As a result `ACTION_UUID` intent is not received.\nSo I decided to take a simpler approach to just wait for the service discovery to complete via a timeout.",
      "parentUuid": "67045bc2_7f403743",
      "range": {
        "startLine": 323,
        "startChar": 8,
        "endLine": 323,
        "endChar": 12
      },
      "revId": "6dd06554ecc90e093c2952477ec6a6537f9490b9",
