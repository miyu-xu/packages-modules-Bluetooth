      "writtenOn": "2022-10-07T13:42:11Z",
      "side": 1,
      "message": "What about a stack that reuses advertising sets.  Do they need to clear the scan response data before starting a non-scannable advertisement with a set that used to be scannable?",
      "range": {
        "startLine": 403,
        "startChar": 0,
        "endLine": 404,
        "endChar": 40
      },
      "revId": "2d8ca7d435dd891ee27bc6fd3fd3dafbf25ef587",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "21d7348a_dc5d11f6",
