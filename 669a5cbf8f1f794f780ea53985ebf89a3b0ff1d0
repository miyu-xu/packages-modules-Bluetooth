      "writtenOn": "2022-07-18T09:06:18Z",
      "side": 1,
      "message": "Does the `Disconnect` of `host.proto` could be used here ?",
      "revId": "669a5cbf8f1f794f780ea53985ebf89a3b0ff1d0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
