        "id": 1881539
      },
      "writtenOn": "2022-07-18T09:06:18Z",
      "side": 1,
      "message": "This seems to overlap with the `Connect` rpc in `host.proto`, would it be possible to reuse it and take a `Connection` instead of an Address here ?",
      "revId": "669a5cbf8f1f794f780ea53985ebf89a3b0ff1d0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
