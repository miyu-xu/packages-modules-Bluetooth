      },
      "writtenOn": "2022-07-19T17:03:04Z",
      "side": 1,
      "message": "We\u0027ll discuss this, but this is not part of this change",
      "parentUuid": "cd1d86e7_524bc381",
      "revId": "669a5cbf8f1f794f780ea53985ebf89a3b0ff1d0",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
