      "writtenOn": "2024-03-21T14:22:36Z",
      "side": 1,
      "message": "Have a flag to switch between BTA_HH_EMPTY_EVT and BTA_HH_ENABLE_EVT?\n\nSo that we can verify whether the new value will hurt something",
      "range": {
        "startLine": 700,
        "startChar": 6,
        "endLine": 700,
        "endChar": 38
      },
      "revId": "00145e02022a2df9e00159379a177e608aa59cc2",
