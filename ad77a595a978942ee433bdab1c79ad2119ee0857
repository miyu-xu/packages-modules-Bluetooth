        "id": 1881539
      },
      "writtenOn": "2023-05-08T14:38:44Z",
      "side": 1,
      "message": "Having an async fn returning a future is a bit weird.\n\nCould we make this just one async function ? Asked differently, do you need the two level of Result ?",
      "range": {
        "startLine": 159,
        "startChar": 4,
        "endLine": 159,
        "endChar": 10
      },
      "revId": "ad77a595a978942ee433bdab1c79ad2119ee0857",
