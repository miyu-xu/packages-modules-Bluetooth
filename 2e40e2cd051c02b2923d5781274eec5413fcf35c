      "writtenOn": "2023-09-29T16:43:35Z",
      "side": 1,
      "message": "This method would require us to call 2 APIs instead of 1 for an AD type. This might be more complicated for the user to understand.",
      "parentUuid": "8773af24_d2a04f52",
      "range": {
        "startLine": 664,
        "startChar": 0,
