      "writtenOn": "2024-10-31T19:16:07Z",
      "side": 1,
      "message": "Why not keeping the former naming? (i.e. `TYPE_L2CAP_LE`) This seems to be more future proof than just `TYPE_LE` as we can potentially have sockets on isochronous LE channels in the future.",
      "range": {
        "startLine": 135,
        "startChar": 4,
        "endLine": 135,
        "endChar": 40
      },
      "revId": "2201ea94256c547f9f7c7ad9d62b528c0da6365e",
