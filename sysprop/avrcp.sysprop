module: "android.sysprop.bluetooth.Avrcp"
owner: Platform

prop {
    api_name: "absolute_volume"
    type: Boolean
    scope: Internal
    access: Readonly
    prop_name: "bluetooth.avrcp.absolute_volume.enabled"
}

prop {
    api_name: "sink_absolute_volume"
    type: Boolean
    scope: Internal
    access: Readonly
    prop_name: "bluetooth.profile.avrcp.controller.absolute_volume.enabled"
}
