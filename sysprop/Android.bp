package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "com.android.sysprop.bluetooth.srcs",
    srcs: [
        "avrcp.sysprop",
        "bta.sysprop",
        "hfp.sysprop",
        "pan.sysprop",
    ],
}

sysprop_library {
    name: "com.android.sysprop.bluetooth",
    host_supported: true,
    srcs: [
        ":com.android.sysprop.bluetooth.srcs",
    ],
    property_owner: "Platform",
    api_packages: ["android.sysprop"],
    cpp: {
        min_sdk_version: "Tiramisu",
    },
    apex_available: ["com.android.btservices"],
}

// Generate Rust proto parser code
gensrcs {
    name: "bluetooth_sysprop_rust_gen",
    srcs: [
        "bluetooth_sysprop.proto",
    ],
    output_extension: "rs",
    tools: [
        "aprotoc",
        "protoc-gen-rust",
    ],
    cmd: "$(location aprotoc)" +
        " --plugin=$(location protoc-gen-rust)" +
        " --rust_out=`dirname $(out)` $(in)",
}

rust_library {
    name: "libbluetooth_sysprop_proto",
    crate_name: "bluetooth_sysprop_proto",
    srcs: [
        ":bluetooth_sysprop_rust_gen",
    ],
    rustlibs: [
        "libprotobuf",
    ],
    features: ["proto"],
    host_supported: true,
}

// Binary to take encoded BluetoothProperties message and to generate C macro
// output
rust_binary_host {
    name: "bluetooth_sysprop_parser",
    srcs: [
        "main.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libbluetooth_sysprop_proto",
        "libclap",
        "libnum_traits",
        "libprotobuf",
    ],
    prefer_rlib: true,
}

// Uncomment the default value in bluetooth sysprop
gensrcs {
    name: "bluetooth_sysprop_with_default",
    srcs: [
        ":com.android.sysprop.bluetooth.srcs",
    ],
    output_extension: "sysprop.with_default",
    cmd: "sed -e 's/^\\( *\\)# \\(default_value\\)/\\1\\2/'" +
        " < $(in)" +
        " > $(out)",
}

// Encode sysprop from text format
// This can be deprecated once text_format::parse_from_str is available in
// android (need protobuf > 3)
gensrcs {
    name: "bluetooth_sysprop_encoded",
    srcs: [
        ":bluetooth_sysprop_with_default",
    ],
    output_extension: "encoded",
    tools: [
        "aprotoc",
    ],
    cmd: "$(location aprotoc)" +
        " --encode=sysprop.Properties" +
        " packages/modules/Bluetooth/sysprop/bluetooth_sysprop.proto" +
        " < $(in)" +
        " > $(out)",
}

// generate C macro using above tool and encoded message
gensrcs {
    name: "bluetooth_sysprop_autogen",
    srcs: [
        ":bluetooth_sysprop_encoded",
    ],
    output_extension: "autogenerated",
    tools: [
        "bluetooth_sysprop_parser",
    ],
    cmd: "$(location bluetooth_sysprop_parser) --genDir $(genDir) --in $(in) --out $(out)",
    // tool_files : [
    //   "bluetooth_sysprop_parser.sh",
    // ],
    // cmd: "$(location bluetooth_sysprop_parser.sh) --in $(in) --out $(out)",
}

// concatenate C macro and include into two files
genrule {
    name: "bluetooth_sysprop_merged_output",
    srcs: [
        ":bluetooth_sysprop_autogen",
    ],
    out: [
        "android_autogen_include.h",
        "sysprop_autogen_macro.h",
    ],
    cmd: "cat $(in) > $(genDir)/sysprop_autogen_macro.h && for i in $(in); do echo \"#include <$$(basename $${i} | sed 's/\\..*$$//').sysprop.h>\" >> $(genDir)/android_autogen_include.h; done",
}

// Accessible library to be used in Bluetooth codebase
cc_library_static {
    name: "bluetooth_property_wrapper",
    host_supported: true,
    srcs: [
        "sysprop_wrapper.cc",
    ],
    generated_headers: [
        "bluetooth_sysprop_merged_output",
    ],
    static_libs: [
        "libcom.android.sysprop.bluetooth",
    ],
    min_sdk_version: "Tiramisu",
    apex_available: ["com.android.btservices"],
}
