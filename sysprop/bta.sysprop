module: "android.sysprop.bluetooth.Bta"
owner: Platform

prop {
    api_name: "disable_delay"
    type: Integer
    scope: Internal
    access: Readonly
    prop_name: "bluetooth.bta.disable_delay.millis"
}

prop {
    api_name: "stack_cleanup_wait"
    type: Integer
    scope: Internal
    access: Readonly
    prop_name: "bluetooth.bta.stack_cleanup_wait.millis"
}
