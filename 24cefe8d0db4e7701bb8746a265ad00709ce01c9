      "writtenOn": "2024-11-20T08:58:02Z",
      "side": 1,
      "message": "Quick question:\nWhy does the stack need to know this ?\n\nWhat happen if the app crash without updating this ?",
      "range": {
        "startLine": 92,
        "startChar": 7,
        "endLine": 92,
        "endChar": 19
      },
      "revId": "24cefe8d0db4e7701bb8746a265ad00709ce01c9",
