      },
      "writtenOn": "2023-05-12T22:44:36Z",
      "side": 1,
      "message": "I\u0027ll try it in a CL on top and see what you think.",
      "parentUuid": "0673e231_0a90769b",
      "revId": "60dc72c5ddc0c6081d75972a2c81844534959ef2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
