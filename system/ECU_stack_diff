+  STREAM_TO_UINT16(handle, p);
+  STREAM_TO_UINT16(subrate_factor, p);
+  STREAM_TO_UINT16(peripheral_latency, p);
+  STREAM_TO_UINT16(cont_num, p);
+  STREAM_TO_UINT16(timeout, p);
