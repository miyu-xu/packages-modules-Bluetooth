cc_test {
    name: "libaptx_enc_tests",
    defaults: [
        "mts_defaults",
    ],
    test_suites: ["device-tests"],
    host_supported: true,
    test_options: {
        unit_test: true,
    },
    data: [
        "raw_data/pcm_16bit.raw",
        "raw_data/sample.aptx",
    ],
    srcs: [ "src/aptx.cc" ],
    whole_static_libs: [ "libaptx_enc" ],
    sanitize: {
        address: true,
        cfi: true,
    },
}

cc_test {
    name: "libaptxhd_enc_tests",
    defaults: [
        "mts_defaults",
    ],
    test_suites: ["device-tests"],
    host_supported: true,
    test_options: {
        unit_test: true,
    },
    data: [
        "raw_data/pcm_24bit.raw",
        "raw_data/sample.aptxhd",
    ],
    srcs: [ "src/aptxhd.cc" ],
    whole_static_libs: [ "libaptxhd_enc" ],
    sanitize: {
        address: true,
        cfi: true,
    },
}
