static_library("libldacBT_enc") {
    cflags = [
      "-O2",
      "-Werror",
      "-Wall",
      "-Wextra",
    ]

    sources = [
        "src/ldaclib.c",
        "src/ldacBT.c",
    ]

    include_dirs = [
      "inc",
    ]
}

static_library("libldacBT_abr") {
    cflags = [
      "-O2",
      "-Werror",
      "-Wall",
      "-Wextra",
    ]

    sources = [
      "abr/src/ldacBT_abr.c",
    ]

    include_dirs = [
      "inc",
      "abr/inc",
    ]

    deps = [
      ":libldacBT_enc",
    ]
}
