cc_library {
    name: "libbluetooth_log",
    host_supported: true,
    min_sdk_version: "33",
    apex_available: [
        "com.android.btservices",
    ],
    export_include_dirs: [
        "include",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    srcs: [
        "src/vlog_android.cc",
    ],

    //                             WARNING
    //
    // Before adding any package to the visibility list of the _bluetooth_
    // logging library: be aware that the burden of maintaining the dependents
    // will _always_ fall on the library developer. External repositories
    // will need to be updated for any breaking change.
    //
    // Extending the list within AOSP repositories is acceptable when
    // understanding the risks, extending the list to internal repositories
    // (--> //vendor) is _never_ acceptable.
    //
    visibility: [
        "//hardware/interfaces/bluetooth/aidl/vts",
        "//packages/modules/Bluetooth:__subpackages__",
    ],
}

cc_test {
    name: "libbluetooth_log_test",
    host_supported: true,
    srcs: [
        "src/truncating_buffer_test.cc",
        "src/vlog_test.cc",
    ],
    shared_libs: [
        "libbase",
        "libbluetooth_log",
    ],
}
