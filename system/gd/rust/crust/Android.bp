package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "system_bt_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["system_bt_license"],
}

rust_defaults {
    name: "libcrust_defaults",
    // defaults: ["gd_rust_defaults"],
    crate_name: "crust",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "libcxx",
    ],
    apex_available: [
        "com.android.btservices",
    ],
    min_sdk_version: "30",
    host_supported: true,
}

rust_library_rlib {
    name: "libcrust",
    defaults: ["libcrust_defaults"],
}


rust_ffi_static {
    name: "libcrust_ffi",
    defaults: ["libcrust_defaults"],
}

genrule {
    name: "libcrust_loader_bridge_header",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) --header > $(out)",
    srcs: ["src/loader.rs"],
    out: ["src/loader.rs.h"],
}

genrule {
    name: "libcrust_loader_bridge_code",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) >> $(out)",
    srcs: ["src/loader.rs"],
    out: ["loader.cc"],
}


cc_library_static {
    name: "libcrust_bridge",
    defaults: [
        "gd_ffi_defaults",
    ],
    generated_headers: [
        "cxx-bridge-header",
        "libcrust_loader_bridge_header",
    ],
    generated_sources: [
        "libcrust_loader_bridge_code",
    ],
    export_generated_headers: [
        "cxx-bridge-header",
        "libcrust_loader_bridge_header",
    ],
    include_dirs: [
        "packages/modules/Bluetooth/system/gd",
    ],
    cflags: [
        "-Wno-unused-const-variable",
    ],
    host_supported: true,
    apex_available: [
        "com.android.btservices",
    ],
    min_sdk_version: "30",
}

cc_library_static {
    name: "libcrust_rust_interop",
    defaults: [
        "gd_ffi_defaults",
    ],
    static_libs: [
        "libcrust_bridge",
        "libcrust_ffi",
    ],
    host_supported: true,
    apex_available: [
        "com.android.btservices",
    ],
    min_sdk_version: "30",
}
