genrule {
    name: "bluetooth_host_libraries",
    srcs: [
        ":libbase",
    ],
    // tools: ["soong_zip"],
    out: ["host_libs.zip"],
    cmd: "find $(genDir) | tee $(out)",
}

genrule {
    name: "archive_bluetooth_cert_src_and_bin",
    tools: [
        "soong_zip",
        // host executables
        ":bluetooth_stack_with_facade",
        ":bt_topshim_facade",
        ":root-canal",
    ],
    // tool_files: [
    // ],
    srcs: [
        // cert_test_sources
        "setup.py",
        "blueberry/**/*.py",
        "blueberry/**/*.yaml",
        ":hci_packets_python3_gen", // host_python_hci_packets_library
        ":gd_smp_packets_python3_gen", // host_python_smp_packets_library
        ":bluetooth_stack_with_facade_targetbin", // target executables
    ],
    out: ["bluetooth_cert_src_and_bin.zip"],

    cmd: "$(location soong_zip) -d -o $(out) " +
        "-C packages/modules/Bluetooth/system -D packages/modules/Bluetooth/system " +
        "-C `dirname $(location :hci_packets_python3_gen)` -f $(location :hci_packets_python3_gen) " +
        "-C `dirname $(location :gd_smp_packets_python3_gen)` -f $(location :gd_smp_packets_python3_gen) " +
        "-C `dirname $(location :bluetooth_stack_with_facade)` -f $(location :bluetooth_stack_with_facade) " +
        "-C `dirname $(location :bt_topshim_facade)` -f $(location :bt_topshim_facade) " +
        "-C `dirname $(location :root-canal)` -f $(location :root-canal) " +
        "-P target " +
        "-C `dirname $(location :bluetooth_stack_with_facade_targetbin)` -f $(location :bluetooth_stack_with_facade_targetbin) ",
}
