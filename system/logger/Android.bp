
cc_library_shared {
    name: "libbluetooth_logger",
    host_supported: true,
    apex_available: [
        "com.android.btservices",
    ],
    include_dirs: [
        "include",
    ],
    libs: [
        "liblog"
    ],
    target: {
        android: {
            libs: [
                "liblog",
            ],
            srcs: [
                "vlog_android.cc",
            ],
        },
        host: {
            srcs: [
                "vlog_host.cc",
            ],
        },
    },
}

cc_test_host {
    name: "libbluetooth_logger_test",
    srcs: [
    ],
    shared_libs: [
        "libbluetooth_logger",
    ],
}
