
cc_library_shared {
    name: "libbluetooth_logger",
    host_supported: true,
    apex_available: [
        "com.android.btservices",
    ],
    include_dirs: [
        "packages/modules/Bluetooth/system/logger/include",
    ],
    target: {
        android: {
            shared_libs: [
                "liblog",
                "libbase",
            ],
            srcs: [
                "src/vlog_android.cc",
            ],
        },
        host: {
            shared_libs: [
                "libbase",
            ],
            srcs: [
                "src/vlog_stdout.cc",
            ],
        },
    },
}

cc_test_host {
    name: "libbluetooth_logger_test",
    srcs: [
    ],
    shared_libs: [
        "libbluetooth_logger",
    ],
}
