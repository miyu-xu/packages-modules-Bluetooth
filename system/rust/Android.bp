rust_defaults {
    name: "libbluetooth_core_rs_defaults",
    min_sdk_version: "Tiramisu",
    dylib: {
        enabled: false,
    },
    shared_libs: [
      "libbase",
    ],
    static_libs: [
        "libbluetooth_gd",
        "libbt_shim_bridge",
        "libbt_shim_ffi",

        "libchrome",
        "libmodpb64",
        "libevent",
    ],
    target: {
        android: {
            shared_libs: [
                "android.hardware.bluetooth@1.0",
                "android.hardware.bluetooth@1.1",
                "android.system.suspend.control-V1-ndk",
                "android.system.suspend-V1-ndk",
                "libbinder_ndk",
                "libcutils",
                "libhidlbase",
                "libutils",
                "libstatslog_bt",
            ],
        },
    },
    apex_available: ["com.android.btservices"],
}

rust_ffi {
    name: "libbluetooth_core_rs",
    crate_name: "bluetooth_core",
    defaults: ["libbluetooth_core_rs_defaults"],
    srcs: ["lib.rs"],
    rustlibs: [
        "liblog_rust",
        "libandroid_logger",
        "libcxx",

        // needed just for build system nonsense (ask @licorne why) please do not actually use
        "libbt_shim",
    ],
    proc_macros: [
        "libpaste",
    ],
    whole_static_libs: [
        "libbluetooth_core_rs_bridge",
    ],
    features: [
        // used to enable some hacks needed to make Soong happy
        // grep for this string in *.rs to see details
        "via_android_bp",
    ]
}

rust_test_host {
    name: "libbluetooth_core_rs_test",
    defaults: ["libbluetooth_core_rs_defaults"],
    srcs: ["lib.rs"],
    rustlibs: [
        "liblog_rust",
        "libandroid_logger",
        "libcxx",
    ],
    proc_macros: [
        "libpaste",
    ],
}

cc_library_static {
    name: "libbluetooth_core_rs_bridge",
    defaults: [
        "libchrome_support_defaults",
    ],
    include_dirs: [
        "packages/modules/Bluetooth/system",
        "packages/modules/Bluetooth/system/gd",
        "packages/modules/Bluetooth/system/types",
    ],
    export_include_dirs: ["."],
    static_libs: [
        "libbluetooth_gd",
        "libbt_shim_ffi",
        "libbt_shim_bridge",
    ],
    shared_libs: [
        "libflatbuffers-cpp",
    ],
    generated_headers: [
        "cxx-bridge-header",
        "libbluetooth_core_rs_bridge_codegen_header",

        "BluetoothGeneratedBundlerSchema_h_bfbs",
        "BluetoothGeneratedDumpsysDataSchema_h",
        "BluetoothGeneratedPackets_h",
    ],
    export_generated_headers: [
        "libbluetooth_core_rs_bridge_codegen_header",
    ],
    generated_sources: ["libbluetooth_core_rs_bridge_codegen"],
    apex_available: ["com.android.btservices"],
    min_sdk_version: "33",
}

/// FFI codegen
/// 
/// We generate the static library libbluetooth_core_rs_bridge that is included by libbluetooth_core_rs,
/// and depends on libbluetooth_gd. libbluetooth depends on libbluetooth_core_rs.
/// i.e.
/// libbluetooth -> {libbluetooth_core_rs, libbluetooth_core_rs_bridge} -> libbluetooth_gd
///
/// Thus, FFI can be either:
///  * Rust to GD
///  * Legacy C++ to Rust
///     * GD to Rust only via injected callbacks (libbluetooth_gd does not depend on libbluetooth_core_rs)
///     * Legacy C++ to Rust can be made directly (as libbluetooth *does* depend on libbluetooth_core_rs).
///
/// To add FFI for a new module, create an ffi.rs file, and add it to the filegroup below.

filegroup {
    name: "libbluetooth_core_rs_ffi",
    srcs: [
        "core/ffi.rs",
        "gatt/ffi.rs",
    ],
}

gensrcs {
    name: "libbluetooth_core_rs_bridge_codegen_header",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) --header > $(out)",
    srcs: [":libbluetooth_core_rs_ffi"],
    output_extension: "rs.h",
    export_include_dirs: ["."],
}

gensrcs {
    name: "libbluetooth_core_rs_bridge_codegen",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) > $(out)",
    srcs: [":libbluetooth_core_rs_ffi"],
    output_extension: "cc",
}
