<node name="/org/chromium/mmc/CodecManager"
      xmlns:tp="http://telepathy.freedesktop.org/wiki/DbusSpec#extensions-v0">
  <interface name="org.chromium.mmc.CodecManager">
    <method name="CodecInit">
      <tp:docstring>
        Generate the socket token and start the worker thread
      </tp:docstring>
      <arg name="request" type="ay" direction="in">
        <tp:docstring>
          Serialized CodecInitRequest proto containing the config parameters.
        </tp:docstring>
        <annotation name="org.chromium.DBus.Argument.ProtobufClass"
                    value="::mmc::CodecInitRequest"/>
      </arg>
      <arg name="response" type="ay" direction="out">
        <tp:docstring>
          Serialized CodecInitResponse proto containing the generated socket name.
        </tp:docstring>
        <annotation name="org.chromium.DBus.Argument.ProtobufClass"
                    value="::mmc::CodecInitResponse"/>
      </arg>
    </method>
  </interface>
</node>
