+void AVDT_UpdateDelayReport(uint8_t handle, uint16_t sink_latency) {
+  tAVDT_SCB* p_scb;
+  AVDT_TRACE_DEBUG("%s: handle=%d", __func__, handle);
+
+  /* map handle to scb */
+  p_scb = avdt_scb_by_hdl(handle);
+  if (p_scb->cs.is_split_enabled && (p_scb->cs.tsep == AVDT_TSEP_SNK) &&
