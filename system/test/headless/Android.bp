package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "system_bt_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["system_bt_license"],
}

sh_binary {
    name: "headless_build_timestamp",
    host_supported: true,
    src: "tools/build_timestamp.sh",
}

genrule {
    name: "HeadlessBuildTimestamp",
    tools: [
        "headless_build_timestamp",
    ],
    cmd: "$(location headless_build_timestamp) > $(out)",
    out: [
        "build_timestamp.h",
    ],
}

filegroup {
    name: "BluetoothHeadlessSources",
    srcs: [
        "android_namespace.cc",
        "bt_property.cc",
        "connect/connect.cc",
        "discovery/discovery.cc",
        "dumpsys/dumpsys.cc",
        "get_options.cc",
        "handler.cc",
        "headless.cc",
        "log.cc",
        "main.cc",
        "messenger.cc",
        "nop/nop.cc",
        "pairing/pairing.cc",
        "property.cc",
        "read/name.cc",
        "read/read.cc",
        "scan/scan.cc",
        "sdp/sdp.cc",
        "sdp/sdp_db.cc",
        "util.cc",
    ],
}

cc_binary {
    name: "bt_headless",
    defaults: [
        "fluoride_defaults",
        "latest_android_hardware_bluetooth_audio_ndk_shared",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-date-time",
    ],
    generated_headers: [
        "HeadlessBuildTimestamp",
    ],
    srcs: [":BluetoothHeadlessSources"],
    include_dirs: [
        "packages/modules/Bluetooth/system",
        "packages/modules/Bluetooth/system/gd",
        "packages/modules/Bluetooth/system/stack/include",
    ],
    // The set of libraries and dependencies to build the Android
    // bluetooth stack for a headless environment.
    static_libs: [
        "avrcp-target-service", /// AVRCP service profile
        "lib-bt-packets",
        "lib-bt-packets-avrcp", /// PDL avrcp packet base library
        "lib-bt-packets-base", /// PDL base packet library
        "libFraunhoferAAC", ///  Audio library to encode and decode in the Advanced Audio Coding (AAC) format
        "libPlatformProperties",
        "libaudio-a2dp-hw-utils", /// system::audio_a2dp_hw audio hardware library
        "libbase", /// The Android base library
        "libbluetooth-dumpsys", /// Bluetooth dumpsys library
        "libbluetooth-protos", /// Generated protobuf type library
        "libbluetooth-types", /// Bluetooth common data type library
        "libbluetooth_core_rs", /// Core rust libraries
        "libbluetooth_crypto_toolbox",
        "libbluetooth_gd", /// Gd and all supporting code library
        "libbluetooth_rust_interop", /// Rust C/Cpp bridge and interoperability
        "libbt-audio-asrc",
        "libbt-audio-hal-interface", /// Audio hal interface
        "libbt-bta", /// Bta profiles
        "libbt-bta-core", /// Everything in bta
        "libbt-btu-main-thread",
        "libbt-common", /// Everything in common
        "libbt-hci", /// HCI interface
        "libbt-jni-thread",
        "libbt-sbc-decoder", ///  Low-complexity subband decoder for the A2DP
        "libbt-sbc-encoder", ///  Low-complexity subband encoder for the A2DP
        "libbt-stack", /// Everything in core system::stack::
        "libbt-stack-core", /// Profiles in system::stack::
        "libbt_shim_bridge", /// cxx bridge library for rust
        "libbt_shim_ffi", /// init flags for rust
        "libbtcore", /// Module and stack management
        "libbtdevice", /// Controller, interop and esco
        "libbte", /// Bluetooth execution environment and main::bte main::shim
        "libbtif", /// Everything for system::btif:: profiles
        "libbtif-core", /// Everything for system::btif:: core
        "libc++fs",
        "libchrome", /// The Chrome library
        "libcutils", // property_get_bool
        "libcutils", /// Various C/Cpp utilities
        //        "libdl", /// Dynamic library loading library
        "libevent", /// Event notification library
        "libflatbuffers-cpp", /// Buffer de/serialization library
        "libfmq", /// Fast message queue for HIDL RPC
        "libg722codec", ///  ITU-T standard wideband audio codec
        "libhidlbase", /// HAL interface definition language (HIDL) base library
        "libjsoncpp",
        "liblc3", /// Low Complexity Communication Codec (LC3)
        "liblog", // Android logging library
        "liblog", // __android_log_print
        "libmodpb64",
        "libopus", /// A simple audio encoder, decoder and noise reduction library
        "libosi", /// system::stack::osi
        "libprotobuf-cpp-lite", /// Google protobuf library for Android
        "libstatslog", /// Statistics and metrics logging library
        "libstatslog_bt", /// Bluetooth metrics logging library
        "libudrv-uipc", /// IPC utility
        "libutils", /// Various core C utilities
        "libz",
    ],
    shared_libs: [
        "libbinder_ndk", /// The Android binder library
        "libcrypto", /// The SSL/key library
        "libstatssocket", /// Statistic and metrics socket API
        "server_configurable_flags",
    ],
    host_supported: true,
    target: {
        android: {
            shared_libs: [
                "android.hardware.audio.common-V3-ndk",
                "android.hardware.bluetooth.audio@2.0",
                "android.hardware.bluetooth.audio@2.1",
                "libPlatformProperties",
                "libaaudio", /// API for high-performance audio applications that require low latency
                "libbinder_ndk",
                "libstatssocket",
            ],
            static_libs: [
                "android.hardware.bluetooth.a2dp@1.0",
                "android.hardware.bluetooth@1.0",
                "android.hardware.bluetooth@1.1",
                "android.hardware.common-V2-ndk",
                "android.hardware.common.fmq-V1-ndk",
                "android.system.suspend-V1-ndk",
                "android.system.suspend.control-V1-ndk",
                "libvndksupport", /// Vendor support library
            ],
        },
    },
    header_libs: ["libbluetooth_headers"],
}
