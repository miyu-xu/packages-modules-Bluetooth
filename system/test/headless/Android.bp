package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "system_bt_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["system_bt_license"],
}

sh_binary {
    name: "headless_build_timestamp",
    host_supported: true,
    src: "tools/build_timestamp.sh",
}

genrule {
    name: "HeadlessBuildTimestamp",
    tools: [
        "headless_build_timestamp",
    ],
    cmd: "$(location headless_build_timestamp) > $(out)",
    out: [
        "build_timestamp.h",
    ],
}

filegroup {
    name: "TestHeadlessModules",
    srcs: [
        "connect/connect.cc",
        "discovery/discovery.cc",
        "dumpsys/dumpsys.cc",
        "nop/nop.cc",
        "pairing/pairing.cc",
        "read/name.cc",
        "read/read.cc",
        "scan/scan.cc",
        "sdp/sdp.cc",
        "sdp/sdp_db.cc",
    ],
}

filegroup {
    name: "TestHeadlessCore",
    srcs: [
        "bt_property.cc",
        "get_options.cc",
        "handler.cc",
        "headless.cc",
        "log.cc",
        "main.cc",
        "messenger.cc",
        "property.cc",
        "util.cc",
    ],
}

/// PDL packet base library
pdl_packets_avrcp = "lib-bt-packets-avrcp"
pdl_packets_base = "lib-bt-packets-base"

/// AVRCP service profile
profile_avrcp_service = "avrcp-target-service"

/// Audio hw library
audio_lib_hw_lib = "audio.a2dp.default"

/// Audio hal interface
audio_lib_hal_interface = "libbt-audio-hal-interface"

/// stack::osi
core_lib_osi = "libosi"

/// Bluetooth execution environment and shim
/// main::bte
/// main::shim
core_lib_main = "libbte"

/// Controller, interop and esco
core_lib_device = "libbtdevice"

/// Everything in stack
/// includes: libbt-hci
///           libbt-stack-core
core_lib_stack_base = "libbt-stack"

/// Everything for btif core
core_lib_btif_core = "libbtif-core"

/// Everything for btif profiles
core_lib_btif_profiles = "libbtif"

/// Everything in bta
core_lib_bta_profiles = "libbt-bta"
core_lib_bta_core = "libbt-bta-core"

/// Everything in common
core_lib_common = "libbt-common"

/// The SSL/key library
ext_boringssl = "libcrypto"

/// The chrome library
ext_libchrome = "libchrome"

/// The android base library
sys_libbase = "libbase"

/// Core rust libraries
core_lib_rust = "libbluetooth_core_rs"

/// IPC utility
util_lib_uipc = "libudrv-uipc"

/// HCI interface
core_lib_hci = "libbt-hci"

/// Module and stack management
core_lib_stack_mgmt = "libbtcore"

core_bluetooth_libs = [
    audio_lib_hw_lib,
    audio_lib_hal_interface,
    core_lib_bta_core,
    core_lib_bta_profiles,
    core_lib_btif_core,
    core_lib_btif_profiles,
    core_lib_common,
    core_lib_device,
    core_lib_hci,
    core_lib_main,
    core_lib_osi,
    core_lib_rust,
    core_lib_stack_base,
    core_lib_stack_mgmt,
    util_lib_uipc,
    profile_avrcp_service,
    pdl_packets_avrcp,
    pdl_packets_base,
    // These may be stripped out so we need to link directly with them here too:
    "libbt-hci",
    "libbt-stack-core",
]

cc_binary {
    name: "bt_headless",
    defaults: [
        "fluoride_defaults",
    ],
    cflags: [
        "-DANDROID",
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-date-time",
        "-Wno-unused-parameter",
    ],
    generated_headers: [
        "BluetoothGeneratedDumpsysDataSchema_h",
        "BluetoothGeneratedPackets_h",
        "HeadlessBuildTimestamp",
    ],
    include_dirs: [
        "packages/modules/Bluetooth/system",
        "packages/modules/Bluetooth/system/gd",
        "packages/modules/Bluetooth/system/stack/include",
    ],
    srcs: [
        ":TestHeadlessCore",
        ":TestHeadlessModules",
    ],
    static_libs: core_bluetooth_libs,
    shared_libs: [
        ext_boringssl,
        ext_libchrome,
        sys_libbase,
    ],
    ldflags: ["-rdynamic"],
    target: {
        linux: {
            srcs: [
                ":BluetoothBtaaSources_linux_generic",
                ":BluetoothOsSources_linux_generic",
            ],
        },
        host: {
            srcs: [
                ":BluetoothBtaaSources_host",
                ":BluetoothHalSources_hci_host",
                ":BluetoothOsSources_host",
            ],
        },
        android: {
            srcs: [
                ":BluetoothBtaaSources_android",
                ":BluetoothHalSources_hci_android_hidl",
                ":BluetoothOsSources_android",
            ],
            shared_libs: [
                "android.hardware.bluetooth.audio-V3-ndk", // Required BnBluetoothAudioPort
                "android.hardware.bluetooth.audio@2.0", // Required by libbt-audio-hal-interface
                "android.hardware.bluetooth.audio@2.1", // Required by libbt-audio-hal-interface
                "android.hardware.bluetooth@1.0", // android/hardware/bluetooth/1.0/types.h
                "android.hardware.bluetooth@1.1", // android/hardware/bluetooth/1.1/IBluetoothHci.h
                "libbinder_ndk",
                "libcutils",
                "libhidlbase",
                "libutils",
            ],
            whole_static_libs: [
                "android.hardware.bluetooth-V1-ndk",
                "libstatslog_bt",
            ],
        },
    },
    sanitize: {
        cfi: false,
    },
}
