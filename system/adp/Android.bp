// Common variables
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "system_bt_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["system_bt_license"],
}

btadpCommonIncludes = [
    "packages/modules/Bluetooth/system",
    "packages/modules/Bluetooth/system/stack/include",
]

// libbt-adp static library for target
cc_defaults {
    name: "libbt-adp_defaults",
    defaults: ["fluoride_basic_defaults"],
    include_dirs: btadpCommonIncludes,
    srcs: [
        "ble_advertiser_adp_interface.cc",
        "btm_iso_api_adp_interface.cc",
    ],
    local_include_dirs: [
        "include"
    ],
    static_libs: [
        "libbt-stack",
    ],
    cflags: [
        "-DBUILDCFG",
    ],
    host_supported: true,
}

cc_library_static {
    name: "libbt-adp",
    defaults: ["libbt-adp_defaults"],
    min_sdk_version: "Tiramisu"
}