      "writtenOn": "2024-04-25T21:25:18Z",
      "side": 1,
      "message": "FYI. we had a permission issue on multi-user environment when using `mActivityManager.getUidImportance()` but `mActivityManager.getPackageImportance()` didn\u0027t. That\u0027s the reason to use `mActivityManager.getPackageImportance()`.",
      "parentUuid": "329f4554_b4901d8a",
      "range": {
        "startLine": 717,
        "startChar": 0,
        "endLine": 717,
        "endChar": 78
