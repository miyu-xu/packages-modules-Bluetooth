        "id": 1076123
      },
      "writtenOn": "2023-05-16T00:26:53Z",
      "side": 1,
      "message": "Interesting.  What is taking the extra time?  dis_gatt_c_read_dis_req?",
      "parentUuid": "ae070b30_91edda9c",
      "range": {
        "startLine": 464,
        "startChar": 6,
        "endLine": 464,
        "endChar": 13
      },
      "revId": "7468ea1a70142b18de82d117b0c7653fa5960ef7",
