package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "service-bluetooth",

    srcs: [
        ":srcs_bluetooth_manager_service_proto",
        ":system-messages-proto-src",
        ":statslog-bluetooth-java-gen",
        ":libbluetooth-binder-aidl",
        ":service-bluetooth-binder-aidl",
        "src/**/*.java",
        "src/**/*.kt",
    ],

    proto: {
        type: "stream",
        include_dirs: [
            "external/protobuf/src",
        ],
    },

    errorprone: {
        javacflags: [
            "-Xep:AlreadyChecked:ERROR",
            "-Xep:CheckReturnValue:ERROR",
            "-Xep:ClassCanBeStatic:ERROR",
            "-Xep:EqualsIncompatibleType:ERROR",
            "-Xep:ReferenceEquality:ERROR",
        ],
    },

    product_variables: {
        pdk: {
            enabled: false,
        },
    },

    sdk_version: "system_server_current",

    lint: {
        strict_updatability_linting: true,
    },

    libs: [
        "framework-annotations-lib",
        "framework-bluetooth.impl",
        "framework-configinfrastructure",
        "framework-statsd.stubs.module_lib",
    ],

    static_libs: [
        "androidx.annotation_annotation",
        "androidx.appcompat_appcompat",
        "bluetooth-proto-enums-java-gen",
        "modules-utils-shell-command-handler",
        "service-bluetooth.change-ids",
        "PlatformProperties",
        "modules-utils-synchronous-result-receiver",
    ],

    installable: true,

    jarjar_rules: ":bluetooth-jarjar-rules",

    optimize: {
        enabled: true,
        shrink: true,
        proguard_flags_files: ["proguard.flags"],
    },

    visibility: [
        "//packages/modules/Bluetooth/apex",
        "//packages/modules/Bluetooth/service/tests",
    ],

    apex_available: [
        "com.android.btservices",
    ],

    min_sdk_version: "Tiramisu",
}
