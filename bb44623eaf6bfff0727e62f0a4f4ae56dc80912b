      },
      "writtenOn": "2024-05-28T19:05:01Z",
      "side": 1,
      "message": "+1. Flags are not supposed to be target specific, they are only here for enabling to rollout a feature progressively.",
      "parentUuid": "a07628cd_171ad0fe",
      "revId": "bb44623eaf6bfff0727e62f0a4f4ae56dc80912b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "f8972986_6985b044",
        "filename": "/PATCHSET_LEVEL",
        "patchSetId": 8
      },
      "lineNbr": 0,
