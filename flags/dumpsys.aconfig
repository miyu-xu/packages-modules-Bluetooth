package: "com.android.bluetooth.flags"

flag {
    name: "dumpsys_use_passed_in_fd"
    namespace: "bluetooth"
    description: "Use the passed in filedescriptor to write dumpsys output"
    bug: "319277798"
}

flag {
    name: "dumpsys_le_audio_use_global_namespace"
    namespace: "bluetooth"
    description: "Use the global le_audio namespace rather than bluetooth::"
    bug: "319279029"
}
