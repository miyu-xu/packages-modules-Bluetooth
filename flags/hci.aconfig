package: "com.android.bluetooth.flags"
container: "com.android.btservices"

flag {
    name: "unified_connection_manager"
    namespace: "bluetooth"
    description: "Manage connections centrally and remove the ACL shim layer"
    bug: "349469413"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "handle_unexpected_vendor_specific_command_status"
    namespace: "bluetooth"
    description: "If vendor specific command receives an unexpected command status, don't treat as a hard failure"
    bug: "341166368"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
