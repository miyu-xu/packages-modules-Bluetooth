# Generate c++ code for .aconfig files
#
# Parameters:
#   sources: files of aconfig flag declaration
#   container: container of these falgs
template("aconfig_declarations") {
  forward_variables_from(invoker, [ "sources", "container" ])
  assert(defined(sources), "sources must be set")
  assert(defined(container), "container must be set")

  proto_bin = "aflags.cache"
  package = "${target_name}"
  code_gen = string_replace(package, ".", "_")
  outdir = rebase_path(target_gen_dir)

  declarations = []
  foreach(source, sources) {
    rel_source = rebase_path(source)
    declarations += ["--declarations=${rel_source}"]
  }

  action("${code_gen}_cache") {
    script = "//common-mk/file_generator_wrapper.py"
    args = [
      "aconfig",
      "create-cache",
      "--package=${package}",
      "--container=${container}",
      "--cache=${outdir}/${proto_bin}",
    ]
    args += declarations
    outputs = [
      "${outdir}/${proto_bin}",
    ]
  }

  action("${code_gen}_source") {
    script = "//common-mk/file_generator_wrapper.py"
    args = [
      "aconfig",
      "create-cpp-lib",
      "--cache=${outdir}/${proto_bin}",
      "--out=${outdir}",
    ]

    deps = [
        ":${code_gen}_cache",
    ]

    outputs = [
      "${outdir}/include/${code_gen}.h",
      "${outdir}/${code_gen}.cc",
    ]
  }

  aconfig_sources = [ "${outdir}/${code_gen}.cc" ]
  aconfig_deps = [ ":${code_gen}_source" ]

  all_dependent_config_name = "_${target_name}_all_dependent_config"
  config(all_dependent_config_name) {
    include_dirs = [ "${outdir}/include" ]
  }

  source_set(target_name) {
    sources = []
    sources = aconfig_sources
    public_deps = aconfig_deps
    deps = invoker.deps
    all_dependent_configs = [ ":${all_dependent_config_name}" ]
  }
}
