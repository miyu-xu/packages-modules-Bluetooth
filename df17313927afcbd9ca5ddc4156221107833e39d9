      "writtenOn": "2023-03-21T17:31:36Z",
      "side": 1,
      "message": "Can you explain why pattern is needed ?\nWe want to call the callback from main thread after being sent to jni thread ?\n\nIt looks over-complicated (but they may be a good reason I am not aware of)",
      "range": {
        "startLine": 306,
        "startChar": 3,
        "endLine": 314,
        "endChar": 70
      },
      "revId": "df17313927afcbd9ca5ddc4156221107833e39d9",
