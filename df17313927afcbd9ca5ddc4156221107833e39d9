    },
    {
      "unresolved": true,
      "key": {
        "uuid": "1b497f7e_0aa9e468",
        "filename": "system/btif/avrcp/avrcp_service.cc",
        "patchSetId": 7
      },
      "lineNbr": 314,
      "author": {
        "id": 1974186
      },
      "writtenOn": "2023-03-22T09:34:58Z",
      "side": 1,
      "message": "We are passing callback from native (device.cc), that will be later run, when the JNI receives the response from Java layer. Here we need to assure, that the callback will be run on the main thread. Why on the main thread: I\u0027ve read somewhere that UI related things should run on the main thread, and shuffle/repeat are UI related. \n\nThat\u0027s what I understand - it might not be right ;) Anyway, I am open to propositions, how to do it better ;)",
      "parentUuid": "b043137a_b4f6ba67",
      "range": {
        "startLine": 306,
        "startChar": 3,
        "endLine": 314,
        "endChar": 70
      },
      "revId": "df17313927afcbd9ca5ddc4156221107833e39d9",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
