      "writtenOn": "2022-10-03T22:06:38Z",
      "side": 1,
      "message": "What is the intention here? According the HashMap::insert, the closure will be executed if it\u0027s a new insert. But looks like you want to call the closure if the old value is different from the new value, is that right?",
      "range": {
        "startLine": 167,
        "startChar": 76,
        "endLine": 172,
        "endChar": 11
      },
      "revId": "34f90c14344364d9a054c1c03a1ba954a397f2ef",
