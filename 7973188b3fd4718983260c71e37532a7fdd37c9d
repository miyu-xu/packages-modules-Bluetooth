      "writtenOn": "2023-08-28T07:52:01Z",
      "side": 1,
      "message": "Does this need to be a fatal error? Maybe we can return an empty result?",
      "range": {
        "startLine": 79,
        "startChar": 2,
        "endLine": 79,
        "endChar": 12
      },
      "revId": "7973188b3fd4718983260c71e37532a7fdd37c9d",
