      "writtenOn": "2024-09-17T21:13:24Z",
      "side": 1,
      "message": "That doesn\u0027t seems correct to me.\nhaving a onEnter that is evaluating the condition that brought it here seems to go against the state machine pattern. I prefer to call everything inside this if from the actual message processing of DISCONNECT and remove the `if what \u003d\u003d ` from this method",
      "range": {
        "startLine": 1966,
        "startChar": 11,
        "endLine": 1966,
        "endChar": 57
      },
      "revId": "f352c31c5318c9a810f7095a88a04deaf24fe355",
