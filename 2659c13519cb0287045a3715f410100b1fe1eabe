      "writtenOn": "2022-08-11T23:28:00Z",
      "side": 1,
      "message": "What happens if you don\u0027t wait?",
      "range": {
        "startLine": 110,
        "startChar": 6,
        "endLine": 112,
        "endChar": 99
      },
      "revId": "2659c13519cb0287045a3715f410100b1fe1eabe",
