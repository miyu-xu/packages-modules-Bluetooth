    {
      "unresolved": true,
      "key": {
        "uuid": "3c023a0d_4799e818",
        "filename": "android/pandora/server/src/com/android/pandora/Gatt.kt",
        "patchSetId": 6
      },
      "lineNbr": 112,
      "author": {
        "id": 1880948
      },
      "writtenOn": "2022-08-12T00:01:05Z",
      "side": 1,
      "message": "BluetoothGatt#discoverServiceByUuid() will return true, we will return and the PTS-bot will be stuck until timeout.\nWhat happens is that the native call for discovery will fail because the native is busy, so we won\u0027t discover the services when needed.",
      "parentUuid": "5442f571_8c37dd07",
      "range": {
        "startLine": 110,
        "startChar": 6,
        "endLine": 112,
        "endChar": 99
      },
