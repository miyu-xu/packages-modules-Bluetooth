      "writtenOn": "2021-12-06T21:43:44Z",
      "side": 1,
      "message": "Would it make sense to initialize SongInfo and not add the media_id below?  Does the carkit need info to be initialized when we return it on 364?\n\nSongInfo info{};",
      "range": {
        "startLine": 362,
        "startChar": 0,
        "endLine": 364,
        "endChar": 39
      },
      "revId": "c48d7e5415c17dca2d688c24de125df553b6472a",
