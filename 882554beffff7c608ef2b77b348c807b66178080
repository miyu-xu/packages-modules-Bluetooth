      },
      "writtenOn": "2024-02-19T21:07:38Z",
      "side": 1,
      "message": "same as above, this CL breaks the atomic block into two blocks. Maybe we should hold the write lock from the beginning?",
      "range": {
        "startLine": 3664,
        "startChar": 0,
        "endLine": 3664,
        "endChar": 27
      },
      "revId": "882554beffff7c608ef2b77b348c807b66178080",
