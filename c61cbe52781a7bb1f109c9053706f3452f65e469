        "id": 3256421
      },
      "writtenOn": "2024-11-20T11:32:05Z",
      "side": 1,
      "message": "Is there no risk of race between StartAudioBroadcast and OnAudioResume while going back to broadcast?",
      "range": {
        "startLine": 1356,
        "startChar": 0,
        "endLine": 1356,
        "endChar": 58
      },
      "revId": "c61cbe52781a7bb1f109c9053706f3452f65e469",
