      "writtenOn": "2024-11-21T09:00:54Z",
      "side": 1,
      "message": "What race ?\n\nAFAIK when ble_broadcast device is connected, driver tries to start this device for some time, because there is no guarantee to fit in time with e.g. signalling in one request.",
      "parentUuid": "374a09de_57320900",
      "range": {
        "startLine": 1356,
        "startChar": 0,
        "endLine": 1356,
        "endChar": 58
      },
      "revId": "c61cbe52781a7bb1f109c9053706f3452f65e469",
