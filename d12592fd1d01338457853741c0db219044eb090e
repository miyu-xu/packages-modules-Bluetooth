      "writtenOn": "2025-02-13T19:20:22Z",
      "side": 1,
      "message": "\u003e Note: this is changed from (timestamp - last_flush) \u003e interval as to avoid subtraction of unsigned integers.\n\nFYI Both have well defined overflow semantic in C/C++",
      "parentUuid": "7297b13c_789f9794",
      "range": {
        "startLine": 167,
        "startChar": 6,
        "endLine": 167,
