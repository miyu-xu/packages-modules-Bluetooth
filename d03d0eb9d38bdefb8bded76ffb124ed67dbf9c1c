      },
      "lineNbr": 350,
      "author": {
        "id": 1882530
      },
      "writtenOn": "2024-01-29T19:50:05Z",
      "side": 1,
      "message": "As the number tests grow, the number of intents also grows. This would then require all the previous test cases to then check for those new intents. This would mean that every test case is testing the complete state of the system instead of just the specific scenario it was meant to test. This would make the test suite very difficult to maintain.",
      "parentUuid": "6db85d9c_661627f3",
      "revId": "d03d0eb9d38bdefb8bded76ffb124ed67dbf9c1c",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
