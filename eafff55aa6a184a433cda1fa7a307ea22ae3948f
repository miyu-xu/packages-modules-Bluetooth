      "writtenOn": "2023-04-20T16:19:51Z",
      "side": 1,
      "message": "You are limiting to HAL definitions here.\nWouldn\u0027t it be easier to just pass the PAC record to Codec to ask if it supports given configuration ?\nOr just pass the PAC to createInstance and grab codec already properly configured ?",
      "range": {
        "startLine": 43,
        "startChar": 5,
        "endLine": 44,
        "endChar": 51
      },
      "revId": "eafff55aa6a184a433cda1fa7a307ea22ae3948f",
