      },
      "writtenOn": "2022-03-03T08:39:00Z",
      "side": 1,
      "message": "if we do not expect unregisterBearer() to be called after stop(), we can just make methods in TbsService synchronized",
      "parentUuid": "2ff4e431_d69e1759",
      "range": {
        "startLine": 293,
        "startChar": 0,
