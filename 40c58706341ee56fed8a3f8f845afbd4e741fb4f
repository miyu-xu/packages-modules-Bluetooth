      "writtenOn": "2022-07-13T23:41:25Z",
      "side": 1,
      "message": "an alternative that makes use of Rust\u0027s std::fmt design, to build a string without allocating temporary strings:\n\n```\n        use std::fmt::Write;                                                                         \n        let mut err \u003d String::new();                                                                 \n                                                                                                     \n        write!(err, \"port\u003d\").ok();                                                                   \n        match (self.psm, self.channel) {                                                             \n            (Some(psm), Some(cn)) \u003d\u003e write!(err, \"psm {} | cn {}\", psm, cn),                         \n            (None, Some(cn)) \u003d\u003e write!(err, \"cn {}\", cn),                                            \n            (Some(psm), None) \u003d\u003e write!(err, \"psm {}\", psm),                                         \n            (None, None) \u003d\u003e write!(err, \"none\"),                                                     \n        }.ok();                                                                                      \n                                                                                                     \n        write!(err, \", type\u003d{:?}\", self.sock_type).ok();                                             \n                                                                                                     \n        if let Some(name) \u003d \u0026self.name {                                                             \n            write!(err, \", name\u003d{}\", name).ok();                                                     \n        }                                                                                            \n                                                                                                     \n        if let Some(uuid) \u003d \u0026self.uuid {                                                             \n            write!(err, \", uuid\u003d{}\", uuid).ok();                                                     \n        }                                                                                            \n                                                                                                     \n        err\n```",
      "revId": "40c58706341ee56fed8a3f8f845afbd4e741fb4f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
