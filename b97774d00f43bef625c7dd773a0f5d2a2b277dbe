        "id": 1904823
      },
      "writtenOn": "2022-02-17T15:18:17Z",
      "side": 1,
      "message": "Looking at the code it\u0027s not clear in which state you could have the pairing confirmation. I assume that it\u0027s only in STATE_CONNECTING, if it\u0027s the case I would make it clear by adding it in a new branch before the `if (deviceState \u003d\u003d BluetoothAdapter.STATE_CONNECTED)`",
      "range": {
        "startLine": 131,
        "startChar": 18,
        "endLine": 132,
        "endChar": 100
      },
      "revId": "b97774d00f43bef625c7dd773a0f5d2a2b277dbe",
