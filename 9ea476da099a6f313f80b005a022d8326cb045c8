        "id": 3302247
      },
      "writtenOn": "2024-11-01T18:52:41Z",
      "side": 1,
      "message": "Are these supposed to indicate BT spec\u0027s allowed values? If not, how are we determining them (in particular the min of 1024 which is more than BT spec min).",
      "parentUuid": "81e75d98_fd1ff89e",
      "range": {
        "startLine": 54,
        "startChar": 0,
        "endLine": 58,
        "endChar": 72
      },
      "revId": "9ea476da099a6f313f80b005a022d8326cb045c8",
