      "writtenOn": "2024-11-01T18:53:34Z",
      "side": 1,
      "message": "1. that\u0027s right. changed it to private\n2. good point. updated that the framework only checks the maximum value, since the actual value of Rx MTU is determined by the host stack based on the capabilities of the offload stack.",
      "parentUuid": "81e75d98_fd1ff89e",
      "range": {
        "startLine": 54,
        "startChar": 0,
        "endLine": 58,
        "endChar": 72
