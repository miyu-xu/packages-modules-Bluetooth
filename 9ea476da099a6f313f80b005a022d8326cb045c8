      "writtenOn": "2024-11-01T00:51:26Z",
      "side": 1,
      "message": "The name should be the one from the specification: `mL2capMaximumPacketSize`, or the shorter version `mL2capMps` if you prefer. \n\nRfcomm has a similar notion of `Maximum Frame Size`, we could also use `mMaximumPacketSize` and document that it will represent either based on the selected socket type.",
      "range": {
        "startLine": 108,
        "startChar": 16,
        "endLine": 108,
        "endChar": 37
      },
      "revId": "9ea476da099a6f313f80b005a022d8326cb045c8",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
