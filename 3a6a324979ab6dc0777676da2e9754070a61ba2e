      "writtenOn": "2023-05-16T21:42:19Z",
      "side": 1,
      "message": "The ACL packet is in order, it is a PTS-bot issue.\nNormally I would agree with not having a specific fix apply for everyone, but the consequence of delaying the first packet for everyone is very limited I believe, and I would rather keep it simple and apply it equally in this case.",
      "parentUuid": "8539ed43_24e69b4c",
      "revId": "3a6a324979ab6dc0777676da2e9754070a61ba2e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
