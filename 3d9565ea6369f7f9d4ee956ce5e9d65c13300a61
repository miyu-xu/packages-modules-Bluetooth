                "startLine": 92,
                "startChar": 0,
                "endLine": 95,
                "endChar": 0
              },
              "replacement": "  // when using aggressive initial parameters, this function may be called by\n  // L2CA_SetEcosystemBaseInterval() with aggressive parameter. In this case, the\n  // L2C_BLE_AGGRESSIVE_INITIAL_PARAM cannot be reset.\n"
            }
          ]
        }
      ],
      "revId": "3d9565ea6369f7f9d4ee956ce5e9d65c13300a61",
