      },
      "lineNbr": 116,
      "author": {
        "id": 1962300
      },
      "writtenOn": "2024-02-23T09:45:44Z",
      "side": 1,
      "message": "This data is generated in `FlossSocketManagerClient.on_outgoing_connection_result`, which I don\u0027t think is guaranteed to be called before this function. You need to clone `FlossSocketManagerClient.on_outgoing_connection_result`\u0027s implementation here.",
      "range": {
        "startLine": 116,
        "startChar": 16,
        "endLine": 116,
        "endChar": 27
      },
      "revId": "e0e8d4410383426be345acdf925303701aba6f8b",
