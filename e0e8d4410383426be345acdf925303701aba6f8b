      "writtenOn": "2024-02-23T09:45:44Z",
      "side": 1,
      "message": "Implement a getter function in `FlossSocketManagerClient` rather than accessing it\u0027s field directly.",
      "range": {
        "startLine": 116,
        "startChar": 42,
