      "side": 1,
      "message": "Thanks for the explanation Jayden! It seems more clear now :)",
      "parentUuid": "28350f31_2b604e36",
      "revId": "de3f22de2a1022133f6f9ad25c657437e8d4d30e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
