        "id": 1880948
      },
      "writtenOn": "2024-08-08T20:56:18Z",
      "side": 1,
      "message": "Yes, this concerns only browsing, not control. CT can set both an addressed player and a browsing player and these can be different.",
      "parentUuid": "4f5c65f3_b42cb8d0",
      "range": {
        "startLine": 376,
        "startChar": 16,
        "endLine": 376,
        "endChar": 29
