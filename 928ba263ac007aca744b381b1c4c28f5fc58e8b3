    {
      "unresolved": true,
      "key": {
        "uuid": "f78eca0e_230f6b31",
        "filename": "system/bta/le_audio/audio_hal_client/audio_source_hal_asrc.h",
        "patchSetId": 7
      },
      "lineNbr": 44,
      "author": {
        "id": 1076123
      },
      "writtenOn": "2023-11-16T18:59:44Z",
      "side": 1,
      "message": "I prefer explicitly sized types. uint16_t? uint32_t?  size_t?",
      "range": {
        "startLine": 44,
        "startChar": 4,
        "endLine": 44,
        "endChar": 7
      },
      "revId": "928ba263ac007aca744b381b1c4c28f5fc58e8b3",
