      "writtenOn": "2024-01-18T17:12:45Z",
      "side": 1,
      "message": "The resulting decrypted data should be validated to make sure it is correctly formatted (i.e. vector of AD types with no trailing data). Inserting incorrectly formatted data in the middle of the advertising data would corrupt the following AD types.",
      "range": {
        "startLine": 262,
        "startChar": 1,
        "endLine": 262,
        "endChar": 32
