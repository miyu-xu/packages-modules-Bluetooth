      "side": 1,
      "message": "Are we sure that DualModeController is always constructed behind a shared_ptr ?\n\nWe should make make the constructor private and provide a helper `Create` function that always create it behind a shared_ptr",
      "range": {
        "startLine": 55,
        "startChar": 27,
        "endLine": 55,
        "endChar": 75
      },
      "revId": "7ea5f67ca8c063bd2c5c8be64157a1fbefae8c93",
