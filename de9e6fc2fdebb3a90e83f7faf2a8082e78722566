      "writtenOn": "2023-02-08T17:36:53Z",
      "side": 1,
      "message": "I think this is a good time to touch it, unless there\u0027s some reason not to.\n\nHow many places does it touch?",
      "parentUuid": "d9b0a0ac_d3748e77",
      "range": {
        "startLine": 115,
        "startChar": 2,
        "endLine": 115,
        "endChar": 34
      },
      "revId": "de9e6fc2fdebb3a90e83f7faf2a8082e78722566",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "9dc4c36c_fa5d5b2e",
        "filename": "system/stack/include/l2cdefs.h",
